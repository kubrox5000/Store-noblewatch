{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/img-cache/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/store-public.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/reviews-public.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|favicon\\.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!index$).*)",
      "destination": "/api/index?__vercel_path=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__vercel_path=/uploads/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__vercel_path=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__vercel_path=/robots.txt"
    },
    {
      "source": "/((?!api/|assets/|img-cache/|videos/|uploads/|store-public\\.json|reviews-public\\.json|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
