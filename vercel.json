{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/((?!index$).*)",
      "destination": "/api/index?__vercel_path=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__vercel_path=/uploads/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__vercel_path=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__vercel_path=/robots.txt"
    },
    {
      "source": "/((?!api/|assets/|videos/|uploads/|store-public\\.json|reviews-public\\.json|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
