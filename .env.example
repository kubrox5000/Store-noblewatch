# Neon PostgreSQL Connection String (Required for Netlify & Neon deployment)
# Get this from your Neon Console -> Connection Details (e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign admin session tokens on Netlify Functions (recommended: 32+ random characters)
ADMIN_SESSION_SECRET="change-this-to-a-long-random-secret-key"

# Comma-separated Google account emails allowed to log into the Admin Dashboard via Google Sign-In
# Example: ADMIN_EMAILS="owner@gmail.com,manager@gmail.com"
ADMIN_EMAILS=""

# Optional: App URL
APP_URL="https://your-site.netlify.app"
