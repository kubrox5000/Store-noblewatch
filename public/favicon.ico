<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <!-- Luxury 24K Multi-Stop Gold Gradient -->
    <linearGradient id="nobleGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff5cc"/>
      <stop offset="25%" stop-color="#dfb76c"/>
      <stop offset="50%" stop-color="#c5a869"/>
      <stop offset="75%" stop-color="#9d7e35"/>
      <stop offset="100%" stop-color="#694f18"/>
    </linearGradient>

    <!-- Deep Midnight Obsidian Gradient -->
    <radialGradient id="obsidianDial" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#1b1e2a"/>
      <stop offset="60%" stop-color="#0f1118"/>
      <stop offset="100%" stop-color="#07080b"/>
    </radialGradient>

    <!-- Inner Gold Shimmer -->
    <linearGradient id="goldShimmer" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a47d2b"/>
      <stop offset="50%" stop-color="#ffe699"/>
      <stop offset="100%" stop-color="#dfb76c"/>
    </linearGradient>

    <!-- Subtle Drop Shadow -->
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Outer Beveled Gold Seal Rim -->
  <circle cx="32" cy="32" r="30.5" fill="url(#nobleGold)" filter="url(#softGlow)"/>
  
  <!-- Subtle Bevel Notch Ring -->
  <circle cx="32" cy="32" r="28" fill="#08090d"/>
  
  <!-- Obsidian Disc -->
  <circle cx="32" cy="32" r="26.5" fill="url(#obsidianDial)"/>

  <!-- Inner Concentric Golden Thread -->
  <circle cx="32" cy="32" r="24.5" fill="none" stroke="url(#nobleGold)" stroke-width="0.8" opacity="0.65" stroke-dasharray="1 0.75"/>

  <!-- Four Cardinal Diamond Accents -->
  <polygon points="32,8.5 33,9.8 32,11.1 31,9.8" fill="url(#nobleGold)"/>
  <polygon points="32,52.9 33,54.2 32,55.5 31,54.2" fill="url(#nobleGold)"/>
  <polygon points="9.5,32 10.8,31 12.1,32 10.8,33" fill="url(#nobleGold)"/>
  <polygon points="51.9,32 53.2,31 54.5,32 53.2,33" fill="url(#nobleGold)"/>

  <!-- Royal 3-Point Crown Crest -->
  <g filter="url(#softGlow)">
    <!-- Crown Base Band -->
    <path d="M23.5 19.5 L40.5 19.5 C40.5 19.5 40.5 21 40 21.5 C37 22 27 22 24 21.5 C23.5 21 23.5 19.5 23.5 19.5 Z" fill="url(#nobleGold)"/>
    
    <!-- Crown Peaks -->
    <path d="M24 19.5 L24 14.5 L28 17 L32 11.5 L36 17 L40 14.5 L40 19.5 Z" fill="url(#nobleGold)"/>
    
    <!-- Crown Jewels on Tips -->
    <circle cx="24" cy="13.5" r="1.3" fill="url(#goldShimmer)"/>
    <circle cx="32" cy="10.5" r="1.8" fill="#ffffff"/>
    <circle cx="40" cy="13.5" r="1.3" fill="url(#goldShimmer)"/>

    <!-- Center Sapphire/Diamond Accent on Crown Base -->
    <circle cx="32" cy="20.5" r="0.8" fill="#ffffff"/>
  </g>

  <!-- Noblewatch Iconic Serif Monogram "N" -->
  <g filter="url(#softGlow)">
    <path d="
      M 19 25.5 
      L 27 25.5 
      L 27 27.5 
      L 25 27.5 
      L 25 43.5 
      L 27.2 43.5 
      L 27.2 45.5 
      L 19 45.5 
      L 19 43.5 
      L 21.2 43.5 
      L 21.2 27.5 
      L 19 27.5 
      Z
      
      M 24.5 27 
      L 38 44 
      L 39.5 44 
      L 39.5 27.5 
      L 37.5 27.5 
      L 37.5 25.5 
      L 45 25.5 
      L 45 27.5 
      L 43 27.5 
      L 43 43.5 
      L 45 43.5 
      L 45 45.5 
      L 38 45.5 
      L 24 28 
      Z
    " fill="url(#nobleGold)" fill-rule="evenodd"/>
  </g>

  <!-- Bottom Distinction Star / Emblem Marker -->
  <g transform="translate(32, 49.5)">
    <polygon points="0,-2 0.6,-0.6 2,0 0.6,0.6 0,2 -0.6,0.6 -2,0 -0.6,-0.6" fill="url(#goldShimmer)"/>
  </g>
</svg>
